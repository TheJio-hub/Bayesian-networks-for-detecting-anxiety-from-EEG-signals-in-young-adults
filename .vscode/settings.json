{
    "ltex.language": "es-ES",
    "ltex.enabled": [
        "latex",
        "tex",
        "bibtex",
        "markdown",
        "plaintext"
    ],
    "cSpell.enabled": true,
    "cSpell.language": "es,en",
    "cSpell.enabledLanguageIds": [
        "latex",
        "tex",
        "bibtex",
        "markdown",
        "plaintext"
    ],
    "editor.wordWrap": "on",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "latex-workshop.latex.outDir": "%DIR%",
    "latex-workshop.latex.recipe.default": "pdflatex -> biber -> pdflatex",
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "/usr/local/texlive/2026/bin/universal-darwin/pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "%DOC%"
            ]
        },
        {
            "name": "biber",
            "command": "/Users/jovanigallegos/Documents/Maestría/Tesis/Modelos/Bayesian-networks-for-detecting-anxiety-from-EEG-signals-in-young-adults/Documento de tesis/.vscode/biber-arm64.sh",
            "args": [
                "%DOCFILE%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "pdflatex -> biber -> pdflatex",
            "tools": [
                "pdflatex",
                "biber",
                "pdflatex",
                "pdflatex"
            ]
        }
    ]
}
